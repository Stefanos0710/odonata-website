# Password for /admin. At least 12 characters in production.
ADMIN_PASSWORD=
# Two-factor login (required in production). Generate with: npm run setup-2fa
ADMIN_TOTP_SECRET=
# Optional: separate key for signing login sessions. Changing it signs everyone out.
SESSION_SECRET=
# Optional: when set, posting commits to GitHub instead of writing local files.
# Fine-grained token with "Contents: Read and write" on the repo below.
GITHUB_TOKEN=
GITHUB_REPO=Stefanos0710/Odonata-Website
GITHUB_BRANCH=main
